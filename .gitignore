# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# deployment
# deploy.env names the server and points at the SSH key. It does NOT
# match the .env* pattern above (that only catches names starting with
# ".env"), so it needs its own line — without it, `git add .` publishes
# your EC2 hostname and key path.
/deploy.env

# typescript
*.tsbuildinfo
next-env.d.ts

# stray working files kept on disk but out of history.
# The two PNGs are byte-identical duplicates of public/demo/sweaty.png and
# public/demo/dry.png; the html is an unreferenced early draft.
/sweatyback.png
/ChatGPT Image *.png
/truss-preorder_1.html
# Source render for public/product-render.webp; nothing imports it.
/whitebackgroundproduct render.png
# Stray working screenshot; nothing imports it.
/Untitled-2.png
