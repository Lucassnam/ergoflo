# Copy to deploy.env and fill in. deploy.env is gitignored — it names
# your server, and that does not belong in a public repo.
#
#     cp deploy.env.example deploy.env
#
# These settings are used by ./deploy.sh only. They are NOT read by the
# app; runtime secrets live in .env.production ON THE SERVER.

# Public DNS name or IP of the EC2 instance.
# Prefer an Elastic IP or a stable DNS name — the default
# ec2-x-x-x-x.compute.amazonaws.com hostname changes if the instance is
# stopped and started, and then both this file and your A record are stale.
DEPLOY_HOST=ec2-00-00-00-00.us-west-1.compute.amazonaws.com

# SSH login user. Ubuntu AMIs: ubuntu. Amazon Linux AMIs: ec2-user.
DEPLOY_USER=ubuntu

# Path to the .pem key from the EC2 key pair. Must be chmod 400.
# Leave blank to use whatever your ssh-agent/ssh config already provides.
DEPLOY_KEY=~/.ssh/ergoflo-ec2.pem

# Where the repo is checked out on the server. deploy.sh bootstrap
# creates this. Treat it as a build artifact — deploys hard-reset it.
DEPLOY_PATH=/srv/ergoflo-landing

# The branch the server tracks. Pushing to it is what makes a deploy live.
DEPLOY_BRANCH=main

# Used only to verify the deploy actually answers over HTTPS afterwards.
# Must match the site block in the Caddyfile.
DEPLOY_DOMAIN=ergoflo.tech

# Optional. Only if sshd is not on 22.
# DEPLOY_PORT=22
