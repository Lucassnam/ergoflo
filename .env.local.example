# Copy to .env.local and fill in from Settings → API in your Supabase project.
# Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# STRIPE — only needed for route B (the Checkout Session API).
#
# THE SIMPLE PATH NEEDS NOTHING HERE. If you just want preorders live, create
# a Payment Link in the Stripe dashboard and paste it into STRIPE_LINK in
# lib/site.ts. No key, no webhook, no variables below. Read the commerce block
# in lib/site.ts for the trade-off (no rows in the `preorders` table).
#
# Route B gives you orders in your own database. It needs both values below,
# set as Cloudflare Pages environment variables in production — NOT committed
# here, and NOT in .env.local for a deployed build. `next dev` cannot run Pages
# Functions at all, so /api/checkout and /api/stripe-webhook are dead under it;
# test them with `wrangler pages dev out --compatibility-date=2024-06-20`.
#
# Start with a TEST key (sk_test_...). Card 4242 4242 4242 4242 with any future
# expiry and any CVC completes a test payment. Only move to sk_live_ once an
# adult 18+ owns the Stripe account — see docs/plans/2026-08-03-preorder-commerce.md.
STRIPE_SECRET_KEY=

# From the Stripe dashboard: Developers → Webhooks → your endpoint → signing
# secret (whsec_...). Register the endpoint against
# https://ergoflo.tech/api/stripe-webhook for the `checkout.session.completed`
# event. Without this the webhook rejects every delivery and no order is ever
# recorded — the payment still succeeds, so this failure is silent.
STRIPE_WEBHOOK_SECRET=
