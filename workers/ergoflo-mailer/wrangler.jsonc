{
  // Deployed SEPARATELY from the Pages project. From this directory:
  //   npx wrangler deploy
  //
  // Secrets are NOT set here. Set them with `npx wrangler secret put`:
  //   SUPABASE_URL, SUPABASE_SECRET_KEY, RESEND_API_KEY,
  //   MAILER_SHARED_SECRET
  // Anything in `vars` below is plaintext in the dashboard and in git.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ergoflo-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2024-06-20",

  "triggers": {
    // Every 15 minutes. This is a SAFETY NET, not the delivery path:
    // the Stripe webhook pings POST /run the moment an order is recorded,
    // so a confirmation normally goes out in seconds. This catches
    // anything that ping missed (Worker cold, deploy in progress, network
    // blip) and drains retry backoff.
    //
    // It was daily at 15:00 UTC, which meant a buyer checking out at
    // 16:00 waited 23 hours for their confirmation if the ping failed.
    // Fine for a day-30 update, useless for a checkout email.
    //
    // 1440/15 = 96 invocations a day, nowhere near the Workers free
    // limit. Cron Triggers run on UTC and take up to 15 minutes to
    // propagate after a change.
    "crons": ["*/15 * * * *"]
  },

  "vars": {
    // The APEX domain ergoflo.tech is what is verified in Resend
    // (confirmed 2026-08-06 by sending from it). Any address on it works.
    //
    // send.ergoflo.tech is NOT a separate verified domain -- it is the
    // return-path subdomain Resend creates as part of the apex setup, and
    // sending from it returns 403 "domain is not verified". An earlier
    // version of this file had orders@send.ergoflo.tech here and would
    // have failed on the first real order.
    //
    // hello@ and not orders@ because hello@ is a mailbox that demonstrably
    // receives mail -- /privacy publishes it as the data-deletion address.
    // Whether orders@ has a mailbox or alias behind the Namecheap MX is
    // unknown, and these emails tell the buyer to "just reply". A From
    // address whose replies bounce is worse than no reply invitation.
    //
    // The apex SPF was NOT touched by the Resend setup: Resend puts its
    // own SPF on send.ergoflo.tech for the return path, so the Namecheap
    // record serving the mailbox is intact. Do not add a second v=spf1
    // record to the apex -- one SPF record per domain, or it permerrors.
    "MAIL_FROM": "ErgoFlo <hello@ergoflo.tech>",
    "MAIL_REPLY_TO": "hello@ergoflo.tech"
  },

  "observability": {
    // Without this, a failed send is only visible in a live `wrangler
    // tail`, which nobody is watching at 15:00 UTC.
    "enabled": true
  }
}
